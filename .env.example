# Radar Comunitário — configuração local para Docker.
# Copie este arquivo para .env.local e preencha os valores reais.

# SUPABASE_URL: The base URL of your Supabase project (without /rest/v1/).
SUPABASE_URL="https://seu-projeto.supabase.co"
# SUPABASE_ANON_KEY: The publishable/anonymous key for the frontend.
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_ANON_KEY="sua-chave-publicavel"

# Backend-only values. Never expose these as VITE_* variables.
API_NODE_ENV="development"
WHATSAPP_NODE_ENV="development"
API_HOST="0.0.0.0"
API_PORT="4000"
CORS_ORIGINS="http://localhost:3000"
API_BODY_LIMIT="1mb"
SUPABASE_SERVICE_ROLE_KEY="sua-chave-secreta-apenas-no-backend"
API_BASE_URL="http://localhost:4000"
VITE_API_BASE_URL="http://localhost:4000/api/v1"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
AUDIO_RETENTION_DAYS="30"
AUDIO_PROCESSING_STALE_MINUTES="30"
AUDIO_MAX_ATTEMPTS="3"
AUDIO_TRANSCRIPTION_TIMEOUT_SECONDS="90"
AGENT_ID="whatsapp-local-01"
AGENT_TOKEN="replace-with-a-revocable-agent-token"
AGENT_API_URL="http://host.docker.internal:4000/api/v1"
REDIS_URL="redis://redis:6379"
WHATSAPP_SESSION_PATH="/app/.wwebjs_auth"
WHATSAPP_CLIENT_ID="radar-comunitario-v2"
WHATSAPP_POLL_INTERVAL_MS="1000"
WHATSAPP_SEND_DELAY_MS="300"
WHATSAPP_SEND_TIMEOUT_MS="45000"
WHATSAPP_RECONNECT_DELAY_MS="5000"
WHATSAPP_MEDIA_MAX_BYTES="15000000"
WHATSAPP_HEADLESS="true"
CHROMIUM_PATH="/usr/bin/chromium"
